# Copiá este archivo como .env y completá los valores. .env NO se sube al
# repositorio. Usá una wallet solo de prueba, sin fondos reales.

# URL HTTPS de Alchemy para Ethereum Sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/tu-api-key
# Clave privada de la wallet de prueba (MetaMask > Detalles de la cuenta)
PRIVATE_KEY=0xtu-clave-privada
# Opcional: para verificar el código del contrato en Etherscan
ETHERSCAN_API_KEY=
