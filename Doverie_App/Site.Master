<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="Site" %>
<%@ Register Src="~/SelectorIdioma.ascx" TagPrefix="uc" TagName="SelectorIdioma" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <script src="/Scripts/bootstrap.bundle.min.js"></script>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/Default.aspx">
                    <img src="/Content/img/logo.png" alt="Doverie" height="30" class="me-2" />
                    Doverie
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav me-auto">

                        <asp:Panel ID="pnlAdmin" runat="server" CssClass="d-flex" Visible="false">
                            <li class="nav-item">
                                <a class="nav-link" href="/Usuarios.aspx"><%: Traductor.T("nav.usuarios") %></a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <%: Traductor.T("nav.credenciales") %>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" href="/Perfiles.aspx"><%: Traductor.T("nav.perfiles") %></a></li>
                                    <li><a class="dropdown-item" href="/Familias.aspx"><%: Traductor.T("nav.familias") %></a></li>
                                    <li><a class="dropdown-item" href="/Permisos.aspx"><%: Traductor.T("nav.permisos") %></a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Bitacora.aspx"><%: Traductor.T("nav.bitacora") %></a>
                            </li>
                        </asp:Panel>

                        <asp:Panel ID="pnlIdiomas" runat="server" CssClass="d-flex" Visible="false">
                            <li class="nav-item">
                                <a class="nav-link" href="/Idiomas.aspx"><%: Traductor.T("nav.idiomas") %></a>
                            </li>
                        </asp:Panel>

                        <asp:Panel ID="pnlDocumentos" runat="server" CssClass="d-flex" Visible="false">
                            <li class="nav-item">
                                <a class="nav-link" href="/Documentos.aspx"><%: Traductor.T("nav.documentos") %></a>
                            </li>
                        </asp:Panel>

                        <asp:Panel ID="pnlEmpresa" runat="server" CssClass="d-flex" Visible="false">
                            <li class="nav-item">
                                 <a class="nav-link" href="/EmpleadosEmpresa.aspx"><%: Traductor.T("nav.usuarios") %></a>
                            </li>
                        </asp:Panel>

                    </ul>

                    <div class="d-flex align-items-center">
                        <uc:SelectorIdioma ID="SelectorIdioma1" runat="server" />
                        <asp:Panel ID="pnlNoLogueado" runat="server">
                            <a class="btn btn-outline-light btn-sm" href="/Login.aspx"><%: Traductor.T("nav.iniciarSesion") %></a>
                        </asp:Panel>
                        <asp:Panel ID="pnlLogueado" runat="server" CssClass="d-flex align-items-center" Visible="false">
                            <span class="text-light me-3"><asp:Literal ID="litSaludo" runat="server" Mode="Encode" /></span>
                                <asp:Panel ID="pnlMiPerfil" runat="server" CssClass="me-2">
                                    <a class="btn btn-outline-light btn-sm" href="/MiPerfil.aspx"><%: Traductor.T("nav.miPerfil") %></a>
                                </asp:Panel>
                                <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="btn btn-outline-light btn-sm" OnClick="btnCerrarSesion_Click" />
                        </asp:Panel>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container mt-4">
            <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>
</body>
</html>