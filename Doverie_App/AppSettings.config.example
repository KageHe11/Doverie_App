<appSettings>
	<add key="JwtClaveSecreta" value="poné-acá-una-clave-nueva-larga-random" />
	<add key="SmtpHost" value="smtp.gmail.com" />
	<add key="SmtpPort" value="587" />
	<add key="SmtpUser" value="appdoverie@gmail.com" />
