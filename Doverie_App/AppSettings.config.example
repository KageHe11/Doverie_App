<?xml version="1.0" encoding="utf-8"?>
<appSettings>
	<add key="JwtClaveSecreta" value="poné-acá-una-clave-nueva-larga-random" />
	<add key="SmtpHost" value="smtp.gmail.com" />
	<add key="SmtpPort" value="587" />
	<add key="SmtpUser" value="appdoverie@gmail.com" />
	<add key="SmtpPassword" value="tu-nueva-contraseña-de-aplicación" />
	<add key="SmtpFromName" value="Doverie" />
	<!-- Documentos (opcionales). Almacenamiento: "Local" (disco) o "S3" (AWS). Blockchain: "Local" (simulada) o "Nethereum" (Ethereum).
	     Sin las rutas, se usan App_Data/Documentos y App_Data/Blockchain/registro.jsonl. -->
	<add key="Almacenamiento" value="Local" />
	<!-- Almacenamiento="S3": bucket privado y usuario IAM con permiso solo sobre él.
	     Los archivos que ya están en disco se suben con Database/MigrarDocumentosS3.ps1. -->
	<add key="S3Bucket" value="nombre-del-bucket" />
	<add key="S3Region" value="sa-east-1" />
	<add key="S3AccessKey" value="access-key-del-usuario-iam" />
	<add key="S3SecretKey" value="secret-key-del-usuario-iam" />
	<!-- <add key="S3Prefijo" value="documentos/" /> -->
	<!-- <add key="S3ServiceUrl" value="http://127.0.0.1:4566" /> (emulador de S3 para pruebas) -->
	<add key="Blockchain" value="Local" />
	<!-- Blockchain="Nethereum": red Ethereum y contrato DoverieRegistro (carpeta Blockchain).
	     Sepolia: ChainId 11155111, URL de Alchemy. Red local de Hardhat: ChainId 31337,
	     URL http://127.0.0.1:8545. La clave privada es la de una wallet SOLO de prueba. -->
	<add key="BlockchainRpcUrl" value="https://eth-sepolia.g.alchemy.com/v2/tu-api-key" />
	<add key="BlockchainChainId" value="11155111" />
	<add key="BlockchainClavePrivada" value="0xclave-privada-de-la-wallet-de-prueba" />
	<add key="BlockchainContrato" value="0xE9f903669a54678b717FEf28A1bb3412EaD159d8" />
	<add key="BlockchainContratoNFT" value="0x959d6fCbf9c00163A83d11b05c8ed1DFF144AC7D" />
	<add key="BlockchainRed" value="Ethereum Sepolia" />
	<add key="BlockchainExplorador" value="https://sepolia.etherscan.io" />
	<!-- <add key="DocumentosRuta" value="C:\DoverieDatos\Documentos" /> -->
	<!-- <add key="BlockchainLocalRuta" value="C:\DoverieDatos\Blockchain\registro.jsonl" /> -->
	<!-- Pasarela de pago de las suscripciones: "Local" (checkout simulado) o "MercadoPago"
	     (Checkout Pro). Con el Access Token de producción los cobros son reales; con
	     Mercado Pago las renovaciones las paga el Usuario dentro del plazo de gracia. -->
	<add key="PasarelaPago" value="Local" />
	<add key="MercadoPagoAccessToken" value="APP_USR-access-token-de-la-aplicacion" />
	<!-- <add key="MercadoPagoSandbox" value="true" /> (con credenciales de prueba: checkout sandbox) -->
	<!-- Clave de los dígitos verificadores (HMAC). Si cambia, hay que recalcularlos. -->
	<add key="DigitoVerificadorClave" value="poné-acá-una-clave-larga-random-distinta-de-la-JWT" />
	<!-- Cifrado AES-256 de los datos personales (email, DNI, teléfono): sin
	     esta clave no se pueden leer. Guardala aparte; si se pierde, se
	     pierden esos datos. Distinta de las otras claves. -->
	<add key="CifradoClave" value="poné-acá-otra-clave-larga-random" />
</appSettings>